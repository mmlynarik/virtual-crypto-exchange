# Copy to .env.dev (for just rundev) or .env.prod (for just runprod) and fill in.
# docker compose only reads them when passed with --env-file, which the justfile does.

# Signs the backend's JWTs. Generate with: openssl rand -base64 32
JWT_SECRET_KEY=

# From the GitHub OAuth app (dev and prod use different apps)
GITHUB_CLIENT_SECRET=

# Prod only: password of the postgres   database user, used by both the db and api containers
BACKEND_DB_PASSWORD=
