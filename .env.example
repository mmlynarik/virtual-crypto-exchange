# Copy to .env.dev (for make rundev) or .env.prod (for make runprod) and fill in.
# docker compose only reads them when passed with --env-file, which the Makefile does.

# Signs the backend's JWTs. Generate with: openssl rand -base64 32
JWT_SECRET_KEY=

# From the GitHub OAuth app (dev and prod use different apps)
GITHUB_CLIENT_SECRET=

# Prod only
POSTGRES_PASSWORD=
DJANGO_SUPERUSER_PASSWORD=
